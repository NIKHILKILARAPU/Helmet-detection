# TrafficGuard AI - Python FastAPI Backend Environment

# Server Host and Port
API_HOST=0.0.0.0
API_PORT=8000

# Roboflow Hosted Model Configuration
ROBOFLOW_API_KEY=your_roboflow_api_key_here
ROBOFLOW_MODEL_ID=helmet-and-no-helmet-rider-detection/6
ROBOFLOW_BASE_URL=https://detect.roboflow.com
INFERENCE_PROVIDER=roboflow

# MongoDB Database Configuration
# Default database name: helmet_challan_db
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=helmet_challan_db
MONGO_CONNECT_TIMEOUT_MS=5000
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=10000

# CORS Allowed Origins (Frontend development and staging)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Local YOLO Model Weights Path (Fallback or standalone)
YOLO_MODEL_PATH=../models/yolov8n-traffic.pt
INFERENCE_CONFIDENCE_THRESHOLD=0.50

# Security (JWT secret for production authentication - set securely in production)
SECRET_KEY=development_trafficguard_super_secret_key_change_in_production_32b
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
