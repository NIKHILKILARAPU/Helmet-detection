# TrafficGuard AI - Python FastAPI Backend Environment

# Server Host and Port
API_HOST=0.0.0.0
API_PORT=8000

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=trafficguard_ai

# CORS Allowed Origins (Frontend development and staging)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Model Weights Path (Outside frontend directory)
YOLO_MODEL_PATH=../models/yolov8n-traffic.pt
INFERENCE_CONFIDENCE_THRESHOLD=0.65

# Security (JWT secret for production authentication)
SECRET_KEY=change_this_to_a_secure_random_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
