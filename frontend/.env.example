# TrafficGuard AI - Frontend Environment Configuration

# Base URL for the Python FastAPI backend service
# Default: http://127.0.0.1:8000/api/v1
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# AI Inference Server Endpoint (Optional / When separated from main API)
VITE_MODEL_SERVICE_URL=http://localhost:8001/predict

# Application Environment Mode ('development' | 'production')
VITE_APP_ENV=development

# Enable In-Memory Demo Fallback when backend is unreachable (true | false)
VITE_ENABLE_DEMO_FALLBACK=true
